---
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  const tools: Array<{ slug: string; title: string }> = [];
  return tools.map((t) => ({ params: { slug: t.slug }, props: { title: t.title } }));
}

const { title } = Astro.props as { title: string };
---

<BaseLayout title={`${title} — Tools`}>
  <section class="space-y-4">
    <h1 class="text-3xl font-bold">{title}</h1>
    <p class="text-sm text-neutral-500">TODO: mount tool island here.</p>
  </section>
</BaseLayout>
