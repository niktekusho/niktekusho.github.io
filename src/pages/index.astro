---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Nicola Dal Maso">
  <section class="space-y-4">
    <h1 class="text-3xl font-bold">Hey, I'm Nicola.</h1>
    <p class="text-neutral-700 dark:text-neutral-300">
      Software engineer. This site hosts my CV, a few browser-based tools and games, and a photo gallery.
    </p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4">
      <li><a class="block rounded border border-neutral-200 dark:border-neutral-800 p-4 hover:bg-neutral-50 dark:hover:bg-neutral-900" href="/cv">CV →</a></li>
      <li><a class="block rounded border border-neutral-200 dark:border-neutral-800 p-4 hover:bg-neutral-50 dark:hover:bg-neutral-900" href="/tools">Tools →</a></li>
      <li><a class="block rounded border border-neutral-200 dark:border-neutral-800 p-4 hover:bg-neutral-50 dark:hover:bg-neutral-900" href="/games">Games →</a></li>
      <li><a class="block rounded border border-neutral-200 dark:border-neutral-800 p-4 hover:bg-neutral-50 dark:hover:bg-neutral-900" href="/gallery">Gallery →</a></li>
    </ul>
  </section>
</BaseLayout>
